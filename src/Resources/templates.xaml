<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 音乐库列表行 -->
    <DataTemplate x:Key="SongRowTemplate">
        <Grid Height="44" Margin="10,0,10,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="62" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock x:Name="idx" Text="{Binding IndexText}" FontSize="12.5"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path x:Name="rowIcon" Width="13" Height="13" Stretch="Uniform"
                      Fill="{DynamicResource Accent}" Visibility="Collapsed"
                      Data="M8.4 5.4 L18.8 12 L8.4 18.6 Z"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="title" Grid.Column="0" Text="{Binding Title}" FontSize="13.5"
                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border x:Name="lyricBadge" Grid.Column="2" Background="{DynamicResource AccentSoft}"
                        CornerRadius="4" Padding="5,1,5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="词" FontSize="10" Foreground="{DynamicResource Accent}" />
                </Border>
            </Grid>

            <TextBlock Grid.Column="2" Text="{Binding ArtistText}" FontSize="12.5"
                       Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,12,0" />

            <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12.5"
                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasLyrics}" Value="True">
                <Setter TargetName="lyricBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="idx" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="rowIcon" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                <Setter TargetName="idx" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="rowIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="rowIcon" Property="Fill" Value="{DynamicResource Text}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 播放队列行 -->
    <DataTemplate x:Key="QueueRowTemplate">
        <Grid Height="46" Margin="10,0,10,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="qidx" Grid.Column="0" Text="{Binding QueueIndexText}" FontSize="12.5"
                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="qtitle" Grid.Column="0" Text="{Binding Title}" FontSize="13.5"
                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" MaxWidth="480" />
                <TextBlock x:Name="qartist" Grid.Column="1" Text="{Binding ArtistText}" FontSize="12"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </Grid>

            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12.5"
                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="qtitle" Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter TargetName="qidx" Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter TargetName="qidx" Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
