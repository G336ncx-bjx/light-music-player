<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 音乐库列表行 -->
    <DataTemplate x:Key="SongRowTemplate">
        <Grid Height="46" Margin="10,0,10,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock x:Name="idx" Text="{Binding IndexText}" FontSize="12.5"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- 批量编辑模式：序号换成复选框，勾的就是选中的 -->
                <CheckBox x:Name="pick" Style="{StaticResource ModernCheckBox}" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Focusable="False"
                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="title" Grid.Column="0" Text="{Binding Title}" FontSize="13.5"
                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock Grid.Column="2" Text="{Binding ArtistText}" FontSize="12.5"
                       Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,10,0" />

            <!-- 「有歌词」徽标放在最右边单独一列，免得贴在歌手名前看着像错位 -->
            <Border x:Name="lyricBadge" Grid.Column="3" Background="{DynamicResource AccentSoft}"
                    CornerRadius="4" Padding="5,1,5,1" VerticalAlignment="Center"
                    HorizontalAlignment="Right" Visibility="Collapsed">
                <TextBlock Text="词" FontSize="10" Foreground="{DynamicResource Accent}" />
            </Border>

            <!-- 每首歌右侧的下载按钮（音频 / 歌词 / 两者） -->
            <Border x:Name="downloadAction" Grid.Column="4" Style="{StaticResource RowAction}"
                    Tag="download" Opacity="0.45" ToolTip="下载这首歌（音频 / 歌词 / 两者）"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M12 3.6 V15 M7 10 L12 15.6 L17 10 M5.6 19.2 H18.4"
                      Stroke="{DynamicResource TextDim}" StrokeThickness="2" Stretch="Uniform"
                      Width="12" Height="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>

        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasLyrics}" Value="True">
                <Setter TargetName="lyricBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                <Setter TargetName="downloadAction" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BatchMode}" Value="True">
                <Setter TargetName="idx" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="pick" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="idx" Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter TargetName="idx" Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 播放队列行 -->
    <DataTemplate x:Key="QueueRowTemplate">
        <Grid Height="46" Margin="10,0,10,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock x:Name="qidx" Text="{Binding QueueIndexText}" FontSize="12.5"
                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="qpick" Style="{StaticResource ModernCheckBox}" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Focusable="False"
                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="qtitle" Grid.Column="0" Text="{Binding Title}" FontSize="13.5"
                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="qartist" Grid.Column="2" Text="{Binding ArtistText}" FontSize="12.5"
                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

            <Border x:Name="removeAction" Grid.Column="3" Style="{StaticResource RowAction}"
                    Tag="remove" Opacity="0.4" ToolTip="从播放队列移除"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M6.6 6.6 L17.4 17.4 M17.4 6.6 L6.6 17.4" Stroke="{DynamicResource TextDim}"
                      StrokeThickness="2" Stretch="Uniform" Width="11" Height="11"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>

            <Border x:Name="downloadAction" Grid.Column="4" Style="{StaticResource RowAction}"
                    Tag="download" Opacity="0.4" ToolTip="下载这首歌（音频 / 歌词 / 两者）"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M12 3.6 V15 M7 10 L12 15.6 L17 10 M5.6 19.2 H18.4"
                      Stroke="{DynamicResource TextDim}" StrokeThickness="2" Stretch="Uniform"
                      Width="12" Height="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="qtitle" Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter TargetName="qidx" Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter TargetName="qidx" Property="FontWeight" Value="Bold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                <Setter TargetName="removeAction" Property="Opacity" Value="1" />
                <Setter TargetName="downloadAction" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BatchMode}" Value="True">
                <Setter TargetName="qidx" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="qpick" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
